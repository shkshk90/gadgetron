/** \file core_defines.h
    \brief Autogenerated header providing definitions of __host__, __device__, and __inline__
           for systems on which CUDA is not installed, and SYCL compatibility macros.
*/

#pragma once

// Notice:
// -------
//
// The header core_defines.h is autogenerated
// by cmake from core_defines.h.in
//

// Definition of CUDA/SYCL availability passed to C++
//

#define GADGETRON_CUDA_IS_AVAILABLE @GADGETRON_CUDA_FOUND_BOOL@
#define GADGETRON_SYCL_IS_AVAILABLE @GADGETRON_SYCL_FOUND_BOOL@

// SYCL compatibility layer
#if GADGETRON_SYCL_IS_AVAILABLE
#include <sycl/sycl.hpp>

// Map CUDA-style decorators to SYCL
#if !defined(__host__)
#define __host__
#endif
#if !defined(__device__)
#define __device__
#endif
#define __inline__ inline
#define __global__

// SYCL does not have __forceinline__, use standard inline
#if !defined(__forceinline__)
#define __forceinline__ inline
#endif

// CUDA to SYCL type mappings will be in separate headers

#elif defined(__CUDACC__)
// CUDA path
#include "cuda_runtime.h"
//Here we bypass the CUDA 9 issues caused when CUDACC was deprecated
#ifdef __CUDACC_VER__
#ifdef __CUDACC_VER_MAJOR__
#undef __CUDACC_VER__
#define __CUDACC_VER__ (__CUDACC_VER_MAJOR__ * 10000 + __CUDACC_VER_MINOR__ * 100)
#endif
#endif

#else
// CPU-only path
#if !defined(__host__)
#define __host__
#endif
#if !defined(__device__)
#define __device__
#endif
#define __inline__ inline
#endif
